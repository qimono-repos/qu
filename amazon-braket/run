#!/usr/bin/env bash
# Run a command with Guix python/uv and the profile on LD_LIBRARY_PATH.
# Examples:
#   ./run python topic/script.py
#   ./run jupyter notebook
set -euo pipefail
cd "$(dirname "$0")"
exec guix shell -m ../manifest.scm -- bash -c '
  set -euo pipefail
  export UV_PYTHON_PREFERENCE=only-system
  . ./env.sh
  exec uv run "$@"
' bash "$@"
